---
import portfolio from '../../data/portfolio.json';
import { getTechLogo } from '../../lib/tech-logos';

const { skills } = portfolio;

const groups = skills.groups.map((group) => ({
  ...group,
  items: group.items.map((name) => ({
    name,
    logo: getTechLogo(name),
  })),
}));
---

<section id="skills" class="section-padding surface-mesh border-t border-[var(--color-border)]">
  <div class="container-wide">
    <div class="section-head reveal">
      <p class="section-index">05 — Skills</p>
      <h2 class="section-title">Stack & core competencies</h2>
      <p class="section-lead">
        Deep frontend craft with full-stack ownership — APIs, cloud, and the leadership to ship it.
      </p>
    </div>

    <div class="reveal">
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-sky)]">Core competencies</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {skills.competencies.map((c) => (
          <span class="skill-pill">{c}</span>
        ))}
      </div>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {groups.map((group) => (
        <div class="reveal panel p-5 sm:p-6">
          <h3 class="font-display text-lg font-semibold text-[var(--color-navy)]">{group.name}</h3>
          <div class="divider-navy mt-3 mb-4 max-w-[4rem]"></div>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) =>
              item.logo ? (
                <span class="skill-pill !gap-2">
                  <img
                    src={item.logo.src}
                    alt=""
                    width="16"
                    height="16"
                    class="h-4 w-4 shrink-0"
                    loading="lazy"
                    onerror="this.remove()"
                  />
                  {item.name}
                </span>
              ) : (
                <span class="skill-pill">{item.name}</span>
              ),
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
