---
import portfolio from '../../data/portfolio.json';
import social from '../../data/social.json';
import notifications from '../../data/notifications.json';
import ContactForm from './ContactForm';

const { contact } = portfolio;
const web3formsAccessKey = notifications.web3formsAccessKey || '';
---

<section id="contact" class="section-padding border-t border-[var(--color-border)] bg-white">
  <div class="container-wide">
    <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
      <div class="reveal">
        <p class="section-eyebrow">Contact</p>
        <h2 class="section-title mt-3">{contact.headline}</h2>
        <p class="section-lead mt-4">{contact.description}</p>

        <ul class="mt-8 space-y-4 text-sm">
          <li>
            <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-muted)]">Email</p>
            <a href={`mailto:${contact.email}`} class="mt-1 block font-semibold text-[var(--color-navy)] hover:underline">
              {contact.email}
            </a>
          </li>
          <li>
            <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-muted)]">Phone</p>
            <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="mt-1 block font-semibold text-[var(--color-navy)] hover:underline">
              {contact.phone}
            </a>
            {contact.phoneAlt && (
              <a href={`tel:${contact.phoneAlt.replace(/\s/g, '')}`} class="mt-1 block font-semibold text-[var(--color-navy)] hover:underline">
                {contact.phoneAlt}
              </a>
            )}
          </li>
          <li>
            <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-muted)]">Profiles</p>
            <div class="mt-2 flex flex-wrap gap-4 font-semibold text-[var(--color-navy)]">
              <a href={social.linkedin.url} target="_blank" rel="noopener noreferrer" class="hover:underline">LinkedIn</a>
              <a href={social.github.url} target="_blank" rel="noopener noreferrer" class="hover:underline">GitHub</a>
              <a href={social.npm.url} target="_blank" rel="noopener noreferrer" class="hover:underline">npm</a>
            </div>
          </li>
        </ul>
      </div>

      <div class="reveal rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-alt)] p-6 sm:p-8" style="transition-delay: 80ms">
        <h3 class="font-display text-xl font-bold text-[var(--color-navy)]">Send a message</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)]">Recruiters and hiring managers — include the role and company if you can.</p>
        <div class="mt-6">
          <ContactForm client:visible web3formsAccessKey={web3formsAccessKey} />
        </div>
      </div>
    </div>
  </div>
</section>
