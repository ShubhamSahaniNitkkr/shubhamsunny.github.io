---
import portfolio from '../../data/portfolio.json';
import social from '../../data/social.json';
import notifications from '../../data/notifications.json';
import ContactForm from './ContactForm.astro';

const { contact } = portfolio;
const web3formsAccessKey =
  notifications.web3formsAccessKey || import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || '';
---

<section id="contact" class="section-padding section-glass border-t border-[var(--color-border)]">
  <div class="container-wide">
    <div class="section-head reveal">
      <p class="section-index">08 — Contact</p>
      <h2 class="section-title">{contact.headline}</h2>
      <p class="section-lead">{contact.description}</p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-10">
      <aside class="reveal panel p-6 sm:p-8">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-sky)]">Direct</p>
        <div class="divider-navy mt-3 max-w-[3.5rem]"></div>
        <ul class="mt-6 space-y-6 text-sm">
          <li>
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-[var(--color-muted)]">Email</p>
            <a href={`mailto:${contact.email}`} class="mt-1.5 block break-all font-semibold text-[var(--color-navy)] hover:text-[var(--color-sky)]">
              {contact.email}
            </a>
          </li>
          <li>
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-[var(--color-muted)]">Phone</p>
            <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="mt-1.5 block font-semibold text-[var(--color-navy)] hover:text-[var(--color-sky)]">
              {contact.phone}
            </a>
            {contact.phoneAlt && (
              <a href={`tel:${contact.phoneAlt.replace(/\s/g, '')}`} class="mt-1 block font-semibold text-[var(--color-navy)] hover:text-[var(--color-sky)]">
                {contact.phoneAlt}
              </a>
            )}
          </li>
          <li>
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-[var(--color-muted)]">Profiles</p>
            <div class="mt-3 flex flex-wrap gap-2">
              <a href={social.linkedin.url} target="_blank" rel="noopener noreferrer" class="skill-pill">LinkedIn</a>
              <a href={social.github.url} target="_blank" rel="noopener noreferrer" class="skill-pill">GitHub</a>
              <a href={social.npm.url} target="_blank" rel="noopener noreferrer" class="skill-pill">npm</a>
            </div>
          </li>
        </ul>
      </aside>

      <div class="reveal panel p-6 sm:p-8" style="transition-delay: 50ms">
        <h3 class="font-display text-xl font-semibold text-[var(--color-navy)]">Send a message</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)]">Recruiters — include the role and company if you can.</p>
        <div class="mt-6">
          <ContactForm web3formsAccessKey={web3formsAccessKey} />
        </div>
      </div>
    </div>
  </div>
</section>
