---
import portfolio from '../../data/portfolio.json';

const { usecases } = portfolio;
---

<section id="usecases" class="section-padding border-t border-[var(--color-border)] bg-[var(--color-surface-alt)]">
  <div class="container-wide">
    <div class="reveal max-w-2xl">
      <p class="section-eyebrow">Client Use Cases</p>
      <h2 class="section-title mt-3">Outcomes from real delivery</h2>
      <p class="section-lead mt-4">
        Selected engagements across enterprise analytics, configurable platforms, e-commerce, and AI automation.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {usecases.map((uc, i) => (
        <article
          class="reveal rounded-xl border border-[var(--color-border)] bg-white p-6 sm:p-7"
          style={`transition-delay: ${i * 40}ms`}
        >
          <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-muted)]">{uc.client}</p>
          <h3 class="mt-2 font-display text-xl font-bold text-[var(--color-navy)]">{uc.title}</h3>
          <dl class="mt-5 space-y-4 text-sm leading-relaxed">
            <div>
              <dt class="font-bold text-[var(--color-navy)]">Problem</dt>
              <dd class="mt-1 text-[var(--color-charcoal)]">{uc.problem}</dd>
            </div>
            <div>
              <dt class="font-bold text-[var(--color-navy)]">Solution</dt>
              <dd class="mt-1 text-[var(--color-charcoal)]">{uc.solution}</dd>
            </div>
            <div>
              <dt class="font-bold text-[var(--color-navy)]">Outcome</dt>
              <dd class="mt-1 text-[var(--color-charcoal)]">{uc.outcome}</dd>
            </div>
          </dl>
          <div class="mt-5 flex flex-wrap gap-2">
            {uc.stack.map((s) => (
              <span class="skill-pill !py-1 !text-[11px]">{s}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
