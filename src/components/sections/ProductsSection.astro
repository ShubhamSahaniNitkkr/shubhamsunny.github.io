---
import portfolio from '../../data/portfolio.json';

const { digitalProducts } = portfolio;

const kindLabel: Record<string, string> = {
  npm: 'npm',
  studio: 'Studio',
  platform: 'Platform',
  tool: 'Tool',
};
---

<section id="products" class="section-padding border-t border-[var(--color-border)] bg-[var(--color-navy-deep)] text-white">
  <div class="container-wide">
    <div class="reveal flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/50">07 — Digital Products</p>
        <h2 class="mt-3 font-display text-[clamp(1.85rem,4.2vw,2.65rem)] font-bold text-white">Watch · Use</h2>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-white/70">
          Product surfaces you can open right now — studios, packages, and live tools. Different from the case studies above.
        </p>
      </div>
    </div>

    <div class="mt-10 grid gap-3">
      {digitalProducts.map((product, i) => (
        <div
          class="reveal group flex flex-col gap-4 rounded-2xl border border-white/10 bg-white/[0.04] px-5 py-4 transition hover:border-white/25 hover:bg-white/[0.07] sm:flex-row sm:items-center sm:justify-between sm:px-6"
          style={`transition-delay: ${i * 40}ms`}
        >
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-md bg-white/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white/80">
                {kindLabel[product.kind] || 'Product'}
              </span>
            </div>
            <h3 class="mt-2 font-display text-lg font-bold text-white sm:text-xl">{product.name}</h3>
            <p class="mt-1 text-sm text-white/60">{product.tagline}</p>
          </div>
          <div class="flex shrink-0 flex-wrap gap-2">
            {product.videoUrl ? (
              <a
                href={product.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[40px] items-center rounded-lg border border-white/20 px-4 text-xs font-semibold text-white transition hover:bg-white/10"
              >
                Watch
              </a>
            ) : (
              <span class="inline-flex min-h-[40px] items-center rounded-lg border border-white/10 px-4 text-xs font-semibold text-white/35">
                Video soon
              </span>
            )}
            <a
              href={product.useUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[40px] items-center rounded-lg bg-white px-4 text-xs font-bold text-[var(--color-navy-deep)] transition hover:bg-[var(--color-steel)]"
            >
              Use →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
