---
import portfolio from '../../data/portfolio.json';
import { youtubeEmbedUrl, youtubeWatchUrl } from '../../lib/utils';

const { intro } = portfolio;
const embed = youtubeEmbedUrl(intro.youtubeId);
const interviews = intro.interviews;
---

<section id="intro" class="section-padding border-t border-[var(--color-border)] bg-white">
  <div class="container-wide">
    <div class="reveal max-w-2xl">
      <p class="section-eyebrow">{intro.title}</p>
      <h2 class="section-title mt-3">Meet me in under a few minutes</h2>
      <p class="section-lead mt-4">{intro.description}</p>
    </div>

    <div class="reveal mt-10 grid gap-8 lg:grid-cols-[1.4fr_0.6fr] lg:gap-10">
      <div class="overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-navy-deep)] shadow-sm">
        {embed ? (
          <div class="aspect-video w-full">
            <iframe
              class="h-full w-full"
              src={embed}
              title="Shubham Sunny intro video"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        ) : (
          <div class="flex aspect-video flex-col items-center justify-center gap-3 bg-gradient-to-br from-[var(--color-navy-deep)] to-[var(--color-navy)] px-6 text-center text-white">
            <svg class="h-12 w-12 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" />
            </svg>
            <p class="text-lg font-semibold">Intro video coming soon</p>
            <p class="max-w-sm text-sm text-white/70">Drop your YouTube video ID into <code class="rounded bg-white/10 px-1.5 py-0.5 text-xs">portfolio.json → intro.youtubeId</code></p>
          </div>
        )}
      </div>

      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-navy)]">Interview clips</p>
        <p class="mt-2 text-sm text-[var(--color-muted)]">Short conversations on JavaScript, Frontend, Architecture, and more.</p>
        <ul class="mt-5 space-y-3">
          {interviews.map((item) => {
            const href = item.url || youtubeWatchUrl(item.youtubeId) || '#';
            const ready = Boolean(item.url || item.youtubeId);
            return (
              <li>
                <a
                  href={href}
                  target={ready ? '_blank' : undefined}
                  rel={ready ? 'noopener noreferrer' : undefined}
                  class:list={[
                    'group flex items-center justify-between gap-3 rounded-lg border border-[var(--color-steel-border)] bg-[var(--color-steel)] px-4 py-3 transition',
                    ready ? 'hover:border-[var(--color-navy)] hover:bg-white' : 'opacity-70 cursor-default',
                  ]}
                  aria-disabled={!ready}
                >
                  <div>
                    <p class="text-sm font-bold text-[var(--color-navy)]">{item.label}</p>
                    <p class="text-xs text-[var(--color-muted)]">{item.title}{!ready ? ' · link pending' : ''}</p>
                  </div>
                  <span class="text-[var(--color-navy)] transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>
