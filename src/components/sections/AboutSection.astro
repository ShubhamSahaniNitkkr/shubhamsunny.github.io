---
import portfolio from '../../data/portfolio.json';

const { about, achievements } = portfolio;
---

<section id="profile" class="section-padding section-glass border-t border-[var(--color-border)]">
  <div class="container-wide">
    <div class="section-head reveal">
      <p class="section-index">02 — Profile</p>
      <h2 class="section-title">{about.headline}</h2>
    </div>

    <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:gap-12">
      <div class="reveal space-y-5 text-[1.05rem] leading-relaxed text-[var(--color-charcoal)]/90">
        {about.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
        <ul class="mt-2 flex flex-wrap gap-2">
          {about.highlights.map((item) => (
            <li class="skill-pill">{item}</li>
          ))}
        </ul>
      </div>

      <aside class="reveal space-y-8" style="transition-delay: 50ms">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-sky)]">Education</p>
          <div class="divider-navy mt-3 max-w-[3.5rem]"></div>
          <p class="mt-4 font-display text-xl font-semibold leading-snug text-[var(--color-navy)]">
            {about.education.institution}
          </p>
          <p class="mt-2 text-sm text-[var(--color-muted)]">{about.education.degree}</p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-sky)]">Achievements</p>
          <div class="divider-navy mt-3 max-w-[3.5rem]"></div>
          <ul class="mt-4 space-y-3.5">
            {achievements.map((item) => (
              <li class="flex gap-3 text-sm leading-relaxed text-[var(--color-charcoal)]/90">
                <span class="accent-dot mt-2 shrink-0" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
