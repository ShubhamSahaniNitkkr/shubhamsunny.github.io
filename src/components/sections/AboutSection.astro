---
import portfolio from '../../data/portfolio.json';

const { about, achievements } = portfolio;
---

<section id="profile" class="section-padding border-t border-[var(--color-border)] surface-mesh">
  <div class="container-wide">
    <div class="grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:gap-10">
      <div class="reveal panel p-6 sm:p-8">
        <p class="section-index">02 — Profile</p>
        <h2 class="section-title mt-3">{about.headline}</h2>
        <div class="mt-6 space-y-4 text-[1.015rem] leading-relaxed text-[var(--color-charcoal)]">
          {about.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {about.highlights.map((item) => (
            <li class="flex items-start gap-3 rounded-xl border border-[var(--color-steel-border)] bg-[var(--color-steel)]/50 px-3.5 py-3 text-sm font-medium text-[var(--color-navy-deep)]">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-navy)]" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <aside class="reveal flex flex-col gap-5" style="transition-delay: 100ms">
        <div class="panel p-6">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-navy)]">Education</p>
          <p class="mt-4 font-display text-xl font-bold leading-snug text-[var(--color-navy)]">{about.education.institution}</p>
          <p class="mt-2 text-sm text-[var(--color-muted)]">{about.education.degree}</p>
        </div>
        <div class="panel flex-1 p-6">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-navy)]">Achievements</p>
          <ul class="mt-4 space-y-4">
            {achievements.map((item) => (
              <li class="border-l-2 border-[var(--color-navy)]/30 pl-3 text-sm leading-relaxed text-[var(--color-charcoal)]">
                {item}
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
