---
import portfolio from '../../data/portfolio.json';

const { experience } = portfolio;
---

<section id="experience" class="section-padding section-glass border-t border-[var(--color-border)]">
  <div class="container-wide">
    <div class="section-head reveal">
      <p class="section-index">03 — Experience</p>
      <h2 class="section-title">Companies & impact</h2>
      <p class="section-lead">
        From associate to senior — shipping enterprise platforms, analytics systems, and frontend architectures used at scale.
      </p>
    </div>

    <ol class="reveal relative pl-0">
      {experience.map((job, index) => (
        <li class="relative grid gap-5 pb-12 last:pb-0 sm:grid-cols-[minmax(0,200px)_1fr] sm:gap-10 sm:pl-2">
          {index < experience.length - 1 && (
            <span
              class="timeline-line absolute left-[7px] top-8 hidden h-[calc(100%-0.5rem)] w-px sm:left-[calc(200px+1.35rem)] sm:block"
              aria-hidden="true"
            ></span>
          )}
          <span
            class="timeline-line absolute left-[7px] top-8 h-[calc(100%-0.5rem)] w-px sm:hidden"
            aria-hidden="true"
            style={index === experience.length - 1 ? 'display:none' : undefined}
          ></span>

          <div class="reveal-left relative pl-8 sm:pl-0" style={`transition-delay: ${index * 60}ms`}>
            <span
              class:list={[
                'absolute left-0 top-1.5 flex h-4 w-4 items-center justify-center rounded-full border-2 border-white sm:left-auto sm:right-[-1.85rem]',
                job.current
                  ? 'bg-[var(--color-sky)] shadow-[0_0_0_4px_rgba(15,118,110,0.15)]'
                  : 'bg-[var(--color-steel-border)]',
              ]}
              aria-hidden="true"
            >
              {job.current && <span class="h-1.5 w-1.5 rounded-full bg-white"></span>}
            </span>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-sky)]">{job.period}</p>
            {job.current && (
              <span class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-[var(--color-sky-soft)] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-[var(--color-sky)] ring-1 ring-[var(--color-sky)]/20">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Current
              </span>
            )}
          </div>

          <div class="reveal-right pl-8 sm:pl-8" style={`transition-delay: ${index * 60 + 40}ms`}>
            <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-alt)] px-5 py-4">
              <h3 class="font-display text-xl font-semibold text-[var(--color-navy)] sm:text-2xl">{job.role}</h3>
              <p class="mt-1 text-sm font-semibold text-[var(--color-navy-soft)]">
                {job.company}
                {job.note && <span class="font-medium text-[var(--color-muted)]"> · {job.note}</span>}
              </p>
            </div>
            <ul class="mt-5 space-y-3">
              {job.bullets.map((bullet) => (
                <li class="flex gap-3 text-sm leading-relaxed text-[var(--color-charcoal)]/85">
                  <span class="accent-dot mt-2 shrink-0" aria-hidden="true"></span>
                  {bullet}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
