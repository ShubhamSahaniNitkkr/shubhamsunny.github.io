---
import portfolio from '../../data/portfolio.json';

const { experience } = portfolio;
---

<section id="experience" class="section-padding border-t border-[var(--color-border)] bg-white">
  <div class="container-wide">
    <div class="reveal max-w-2xl">
      <p class="section-index">03 — Experience</p>
      <h2 class="section-title mt-3">Companies & impact</h2>
      <p class="section-lead mt-4">
        From associate to senior — shipping enterprise platforms, analytics systems, and frontend architectures used at scale.
      </p>
    </div>

    <ol class="mt-12 space-y-5">
      {experience.map((job, index) => (
        <li class="reveal panel panel-hover overflow-hidden" style={`transition-delay: ${index * 40}ms`}>
          <div class="grid gap-0 lg:grid-cols-[220px_1fr]">
            <div class="border-b border-[var(--color-border)] bg-[var(--color-steel)]/40 px-5 py-5 lg:border-b-0 lg:border-r">
              <p class="text-xs font-bold uppercase tracking-[0.12em] text-[var(--color-muted)]">{job.period}</p>
              {job.current && (
                <span class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-[var(--color-navy)] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                  Current
                </span>
              )}
            </div>
            <div class="p-5 sm:p-6">
              <h3 class="font-display text-xl font-bold text-[var(--color-navy)] sm:text-2xl">{job.role}</h3>
              <p class="mt-1 text-sm font-semibold text-[var(--color-navy-soft)]">
                {job.company}
                {job.note && <span class="font-normal text-[var(--color-muted)]"> · {job.note}</span>}
              </p>
              <ul class="mt-5 space-y-2.5">
                {job.bullets.map((bullet) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-[var(--color-charcoal)]">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-navy)]" aria-hidden="true"></span>
                    {bullet}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
