---
import portfolio from '../../data/portfolio.json';
import media from '../../data/media.json';
import social from '../../data/social.json';
import { siteConfig } from '../../lib/utils';

const { hero } = portfolio;
---

<section id="about" class="hero-atmosphere relative overflow-hidden pt-24 pb-16 sm:pt-28 sm:pb-20 lg:pt-32 lg:pb-24">
  <div class="pointer-events-none absolute inset-0 opacity-[0.35]" aria-hidden="true"
    style="background-image: linear-gradient(rgba(27,58,107,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(27,58,107,0.04) 1px, transparent 1px); background-size: 48px 48px;"
  ></div>
  <div class="container-wide relative px-4 sm:px-6">
    <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
      <div class="reveal">
        <p class="section-eyebrow">Portfolio · Open to opportunities</p>
        <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-[var(--color-navy)] sm:text-5xl lg:text-[3.5rem] lg:leading-[1.1]">
          {hero.name}
        </h1>
        <p class="mt-4 text-base font-medium italic text-[var(--color-muted)] sm:text-lg">
          {hero.titles.join(' · ')}
        </p>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-[var(--color-charcoal)] sm:text-[1.0625rem]">
          {hero.summary}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={hero.ctas.primary.href} class="btn-accent">{hero.ctas.primary.label}</a>
          <a href={hero.ctas.secondary.href} class="btn-ghost">{hero.ctas.secondary.label}</a>
          <a href={hero.ctas.tertiary.href} class="btn-ghost">{hero.ctas.tertiary.label}</a>
        </div>
        <div class="mt-8 flex flex-wrap gap-2">
          {hero.trust.map((item) => (
            <span class="skill-pill">{item}</span>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-4 text-sm font-semibold text-[var(--color-navy)]">
          <a href={social.linkedin.url} target="_blank" rel="noopener noreferrer" class="hover:underline">LinkedIn</a>
          <span class="text-[var(--color-steel-border)]">|</span>
          <a href={social.github.url} target="_blank" rel="noopener noreferrer" class="hover:underline">GitHub</a>
          <span class="text-[var(--color-steel-border)]">|</span>
          <a href={`mailto:${siteConfig.email}`} class="hover:underline">Email</a>
        </div>
      </div>
      <div class="reveal relative mx-auto w-full max-w-md lg:mx-0 lg:max-w-none" style="transition-delay: 120ms">
        <div class="absolute -inset-3 rounded-[1.5rem] bg-gradient-to-br from-[var(--color-navy)]/15 via-transparent to-[var(--color-navy-soft)]/10" aria-hidden="true"></div>
        <img
          src={media.portrait.src}
          alt={media.portrait.alt}
          width="640"
          height="800"
          class="relative aspect-[4/5] w-full rounded-[1.25rem] object-cover object-top shadow-[0_24px_60px_-28px_rgba(18,40,71,0.45)]"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
