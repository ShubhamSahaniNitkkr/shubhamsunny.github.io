---
import portfolio from '../../data/portfolio.json';
import media from '../../data/media.json';
import social from '../../data/social.json';
import { siteConfig } from '../../lib/utils';

const { hero } = portfolio;
---

<section id="about" class="hero-atmosphere relative overflow-hidden pt-28 pb-16 sm:pt-32 sm:pb-20 lg:pt-36 lg:pb-24">
  <div class="container-wide relative">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div class="hero-cascade min-w-0">
        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--color-sky)]/20 bg-white/90 px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-navy)]">
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          Open to opportunities
        </div>

        <div>
          <p class="mt-6 text-sm font-semibold tracking-[0.14em] text-[var(--color-sky)] uppercase">
            Senior Software Developer · Full-Stack Leadership
          </p>
          <h1 class="mt-3 font-display text-[clamp(2.75rem,7.5vw,4.75rem)] font-semibold leading-[1.05] tracking-tight text-[var(--color-navy)]">
            {hero.name}
          </h1>
          <span class="name-underline" aria-hidden="true"></span>
        </div>

        <p class="mt-5 max-w-xl text-base italic leading-relaxed text-[var(--color-muted)] sm:text-lg">
          Frontend platforms · APIs · Enterprise products · AI that ships
        </p>
        <p class="mt-4 max-w-xl text-[1.05rem] leading-relaxed text-[var(--color-charcoal)]/90">
          {hero.summary}
        </p>

        <div class="mt-8 flex w-full flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={hero.ctas.primary.href} class="btn-accent group">
            {hero.ctas.primary.label}
            <span aria-hidden="true">→</span>
          </a>
          <a href={hero.ctas.secondary.href} class="btn-ghost">{hero.ctas.secondary.label}</a>
          <a href={hero.ctas.tertiary.href} class="btn-ghost">{hero.ctas.tertiary.label}</a>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-semibold">
          <a href={social.linkedin.url} target="_blank" rel="noopener noreferrer" class="link-accent">LinkedIn</a>
          <span class="text-[var(--color-steel-border)]">·</span>
          <a href={social.github.url} target="_blank" rel="noopener noreferrer" class="link-accent">GitHub</a>
          <span class="text-[var(--color-steel-border)]">·</span>
          <a href={`mailto:${siteConfig.email}`} class="link-accent">Email</a>
        </div>
      </div>

      <div class="reveal-right relative mx-auto w-full max-w-sm lg:mx-0 lg:max-w-none">
        <div class="portrait-ring relative">
          <div class="relative overflow-hidden rounded-[1.5rem] bg-[var(--color-navy-deep)]">
            <img
              src={media.portrait.src}
              alt={media.portrait.alt}
              width="560"
              height="700"
              class="aspect-[4/5] w-full object-cover object-top"
              fetchpriority="high"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[var(--color-navy-deep)] via-[var(--color-navy-deep)]/65 to-transparent px-5 pb-5 pt-20">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-teal-300">Currently</p>
              <p class="mt-1 font-display text-lg font-semibold text-white">Yum! Brands</p>
              <p class="text-sm text-white/70">Senior Software Developer</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
