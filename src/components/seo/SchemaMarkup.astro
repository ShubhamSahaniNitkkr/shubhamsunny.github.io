---
import { buildSchemaGraph, type SchemaPageType } from '../../lib/schema';

interface Props {
  type?: SchemaPageType;
  pageUrl?: string;
  pageTitle?: string;
  pageDescription?: string;
}

const { type = 'page', pageUrl, pageTitle, pageDescription } = Astro.props;
const schema = buildSchemaGraph({ type, pageUrl, pageTitle, pageDescription });
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
