---
import { siteConfig } from '../../lib/utils';
import social from '../../data/social.json';
---

<footer class="relative overflow-hidden border-t border-[var(--color-border)] bg-[var(--color-navy-deep)] text-white/65">
  <div class="container-wide relative section-padding !py-12 sm:!py-14">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2 lg:col-span-1">
        <p class="font-display text-2xl font-semibold text-white">
          {siteConfig.brand}<span class="text-teal-300">.</span>
        </p>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/55">
          Senior Software Developer — full-stack leadership, SDUI platforms, performance engineering, and AI that lands in production.
        </p>
        <p class="mt-3 text-xs font-semibold uppercase tracking-[0.14em] text-teal-300/90">
          {siteConfig.stats.yearsExperience}+ years · NIT Kurukshetra
        </p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/90">Navigate</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/#projects" class="transition hover:text-white">Projects</a></li>
          <li><a href="/#blogs" class="transition hover:text-white">Technical Blogs</a></li>
          <li><a href="/#usecases" class="transition hover:text-white">Client Use Cases</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/90">Connect</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href={social.linkedin.url} target="_blank" rel="noopener noreferrer" class="transition hover:text-white">LinkedIn</a></li>
          <li><a href={social.github.url} target="_blank" rel="noopener noreferrer" class="transition hover:text-white">GitHub</a></li>
          <li><a href={social.npm.url} target="_blank" rel="noopener noreferrer" class="transition hover:text-white">npm</a></li>
          <li><a href={`mailto:${siteConfig.email}`} class="transition hover:text-white">Email</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/90">Contact</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>{siteConfig.location}</li>
          <li><a href={`mailto:${siteConfig.email}`} class="break-all transition hover:text-white">{siteConfig.email}</a></li>
          <li><a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`} class="transition hover:text-white">{siteConfig.phone}</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 border-t border-white/10 pt-5 text-center text-xs text-white/35">
      <p>© {new Date().getFullYear()} {siteConfig.brand}. Crafted for impact.</p>
    </div>
  </div>
</footer>
