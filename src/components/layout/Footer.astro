---
import { siteConfig } from '../../lib/utils';
import social from '../../data/social.json';
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface-alt)] text-[var(--color-muted)]">
  <div class="container-wide section-padding !py-12 sm:!py-14">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2 lg:col-span-1">
        <p class="font-display text-xl font-bold text-[var(--color-navy)]">{siteConfig.brand}</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed">
          Senior Software Developer focused on frontend architecture, SDUI, performance engineering, and AI-powered products.
        </p>
        <p class="mt-2 text-xs text-[var(--color-muted-light)]">{siteConfig.stats.yearsExperience}+ years · NIT Kurukshetra</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-navy)]">Navigate</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/#projects" class="hover:text-[var(--color-navy)]">Projects</a></li>
          <li><a href="/#products" class="hover:text-[var(--color-navy)]">Digital Products</a></li>
          <li><a href="/#blogs" class="hover:text-[var(--color-navy)]">Technical Blogs</a></li>
          <li><a href="/#usecases" class="hover:text-[var(--color-navy)]">Client Use Cases</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-navy)]">Connect</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={social.linkedin.url} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-navy)]">LinkedIn</a></li>
          <li><a href={social.github.url} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-navy)]">GitHub</a></li>
          <li><a href={social.npm.url} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-navy)]">npm</a></li>
          <li><a href={`mailto:${siteConfig.email}`} class="hover:text-[var(--color-navy)]">Email</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-navy)]">Contact</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li>{siteConfig.location}</li>
          <li><a href={`mailto:${siteConfig.email}`} class="break-all hover:text-[var(--color-navy)]">{siteConfig.email}</a></li>
          <li><a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`} class="hover:text-[var(--color-navy)]">{siteConfig.phone}</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 border-t border-[var(--color-border)] pt-6 text-center text-xs text-[var(--color-muted-light)]">
      <p>© {new Date().getFullYear()} {siteConfig.brand}. All rights reserved.</p>
    </div>
  </div>
</footer>
