---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import IntroSection from '../components/sections/IntroSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import BlogsSection from '../components/sections/BlogsSection.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import ClientUsecasesSection from '../components/sections/ClientUsecasesSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import site from '../data/site.json';

const seo = site.seo || {};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  ogImage={seo.ogImage}
  ogImageAlt={`${site.brand} — Senior Software Developer`}
  canonical={`${site.domain}/`}
  schemaType="home"
  pageTitle={seo.title}
  pageDescription={seo.description}
>
  <HeroSection />
  <IntroSection />
  <AboutSection />
  <ExperienceSection />
  <ProjectsSection />
  <SkillsSection />
  <BlogsSection />
  <ProductsSection />
  <ClientUsecasesSection />
  <ContactSection />
</BaseLayout>
