    <script is:inline>
      (function () {
        var form = document.getElementById('contactForm');
        if (!form) return;

        var submitBtn = form.querySelector('[data-submit]');
        var statusEl = form.querySelector('[data-status]');
        var defaultLabel = submitBtn ? submitBtn.textContent : 'Send message';

        function setStatus(text, kind) {
          if (!statusEl) return;
          statusEl.hidden = !text;
          statusEl.textContent = text || '';
          statusEl.classList.remove('contact__status--success', 'contact__status--error');
          if (kind) statusEl.classList.add('contact__status--' + kind);
        }

        function openGmailFallback(to, email, project, message) {
          var subject = 'Portfolio inquiry' + (project ? ' — ' + project : '');
          var body = [
            'Hi Shubham,',
            '',
            message,
            '',
            '---',
            'From: ' + email,
            project ? 'Topic: ' + project : '',
            'Sent via portfolio contact form',
          ]
            .filter(Boolean)
            .join('\n');
          var params = new URLSearchParams({
            view: 'cm',
            fs: '1',
            to: to,
            su: subject,
            body: body,
          });
          window.open('https://mail.google.com/mail/?' + params.toString(), '_blank', 'noopener,noreferrer');
        }

        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          if (!submitBtn || submitBtn.disabled) return;

          var email = String(form.email && form.email.value || '').trim();
          var project = String(form.project && form.project.value || '').trim();
          var message = String(form.message && form.message.value || '').trim();
          var accessKey = String(form.dataset.accessKey || '').trim();
          var toEmail = String(form.dataset.toEmail || 'shubhamsahaninitkkr@gmail.com').trim();

          if (!email || !message) {
            setStatus('Please add your email and message.', 'error');
            return;
          }

          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending…';
          setStatus('');

          try {
            if (accessKey) {
              var res = await fetch('https://api.web3forms.com/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({
                  access_key: accessKey,
                  subject: 'Portfolio inquiry' + (project ? ' — ' + project : ''),
                  name: email.split('@')[0] || 'Website visitor',
                  email: email,
                  message: [message, '', project ? 'Topic: ' + project : '']
                    .filter(Boolean)
                    .join('\n'),
                }),
              });
              var json = await res.json().catch(function () { return {}; });
              if (res.ok && json.success) {
                form.reset();
                setStatus('Thanks — your message was sent. I typically reply within one business day.', 'success');
                return;
              }
            }

            openGmailFallback(toEmail, email, project, message);
            setStatus('Opening Gmail as a fallback — click Send there to deliver your message.', 'success');
          } catch (err) {
            openGmailFallback(toEmail, email, project, message);
            setStatus('Something went wrong with the form. Gmail is opening as a fallback.', 'error');
          } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = defaultLabel;
          }
        });
      })();
    </script>
  
