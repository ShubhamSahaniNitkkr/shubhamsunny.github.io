---
import BaseLayout from '../layouts/BaseLayout.astro';

const web3formsAccessKey = String(
  import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || 'df5f568e-3004-429c-8cd7-5799562bda15',
).trim();
---

<BaseLayout>

    <a class="skip-link" href="#main-content">Skip to content</a>
    <a href="#" class="scrolltop" id="scroll-top" aria-label="Back to top">
      <i class="bx bx-chevron-up scrolltop__icon"></i>
    </a>

    <header class="site-header l-header" id="header">
      <nav class="nav bd-container" aria-label="Primary">
        <a href="#home" class="nav__logo">
          <img
            class="nav__logo-icon"
            src="assets/img/favicon.ico"
            alt=""
            width="28"
            height="28"
            decoding="async"
          />
          <span class="nav__logo-text">Shubham Sunny</span>
        </a>

        <div class="nav__menu" id="nav-menu">
          <ul class="nav__list">
            <li class="nav__item" data-section="home">
              <a href="#home" class="nav__link active-link">Home</a>
            </li>
            <li class="nav__item" data-section="intro">
              <a href="#intro" class="nav__link">Intro</a>
            </li>
            <li class="nav__item" data-section="about">
              <a href="#about" class="nav__link">About</a>
            </li>
            <li class="nav__item" data-section="experience">
              <a href="#experience" class="nav__link">Experience</a>
            </li>
            <li class="nav__item" data-section="skills">
              <a href="#skills" class="nav__link">Skills</a>
            </li>
            <li class="nav__item" data-section="portfolio">
              <a href="#portfolio" class="nav__link">Projects</a>
            </li>
            <li class="nav__item" data-section="resume">
              <a href="#resume" class="nav__link">Resume</a>
            </li>
            <li class="nav__item" data-section="testimonial">
              <a href="#testimonial" class="nav__link">Reviews</a>
            </li>
            <li class="nav__item" data-section="services">
              <a href="#services" class="nav__link">Engagements</a>
            </li>
            <li class="nav__item" data-section="contact">
              <a href="#contact" class="nav__link">Contact</a>
            </li>
          </ul>
        </div>

        <button
          type="button"
          class="nav__toggle"
          id="nav-toggle"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <i class="bx bx-menu nav__toggle-icon nav__toggle-icon--open" aria-hidden="true"></i>
          <i class="bx bx-x nav__toggle-icon nav__toggle-icon--close" aria-hidden="true"></i>
        </button>
      </nav>
    </header>

    <main class="l-main" id="main-content">
      <div class="page-snap ps-layer-1" data-section="home">
      <section class="home section-band section-band--hero" id="home" data-section="home" aria-labelledby="hero-title">
        <div class="home__container bd-container">
          <div class="hero__grid">
            <div class="home__data">
              <span class="home__greeting">Senior Software Developer · Remote · India</span>
              <h1 class="home__name" id="hero-title">Shubham Sunny</h1>
              <ul
                class="home__focus-chips"
                aria-label="Core expertise areas"
              >
                <li class="home__focus-chip">Scalable web apps</li>
                <li class="home__focus-chip">AI-driven products</li>
                <li class="home__focus-chip">Intelligent automation</li>
                <li class="home__focus-chip">System design</li>
                <li class="home__focus-chip">React &amp; TypeScript</li>
                <li class="home__focus-chip">Node.js &amp; APIs</li>
                <li class="home__focus-chip">Full-time</li>
                <li class="home__focus-chip">Part-time</li>
                <li class="home__focus-chip">Freelance</li>
              </ul>
              <p class="home__tagline">
                Senior Software Developer with 7+ years of experience building scalable
                web applications, intelligent automation systems, and AI-driven products.
                I lead teams, architect optimized solutions for complex business challenges,
                and deliver systems that handle high-traffic and data-intensive workloads.
              </p>
              <p class="home__tagline home__tagline--secondary">
                As AI reshapes software development, deep technical expertise, strong system
                design, and the right engineering decisions matter more than ever. I am passionate
                about continuous learning and creating meaningful business impact through
                high-quality engineering.
              </p>
              <div class="home__actions">
                <a href="#intro" class="button button--primary home__button">Watch Intro</a>
                <a
                  download=""
                  href="assets/pdf/Shubham_Sunny_Resume_2026_updated.pdf"
                  data-resume-link
                  class="button button--ghost"
                  target="_blank"
                  rel="noopener noreferrer"
                  >Download resume</a
                >
                <a href="#contact" class="button button--ghost">Get in touch</a>
              </div>

              <div class="home__connect">
                <p class="home__connect-label" id="connect-label">Connect</p>
                <div class="home__social" aria-labelledby="connect-label">
                  <a
                    href="https://www.linkedin.com/in/shubham-sunny-09b013129/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="home__social-icon"
                    aria-label="LinkedIn Profile"
                  >
                    <i class="bx bxl-linkedin-square" aria-hidden="true"></i>
                  </a>
                  <a
                    href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=shubhamsahaninitkkr@gmail.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="home__social-icon home__social-icon--gmail"
                    aria-label="Email via Gmail"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                      <path fill="currentColor" d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.521-3.178 4.545-1.997L12 9.458l7.454-4.998C21.479 2.28 24 3.424 24 5.457z"/>
                    </svg>
                  </a>
                  <a
                    href="https://wa.me/+919771823804"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="home__social-icon"
                    aria-label="WhatsApp"
                  >
                    <i class="bx bxl-whatsapp" aria-hidden="true"></i>
                  </a>
                  <a
                    href="https://github.com/ShubhamSahaniNitkkr"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="home__social-icon"
                    aria-label="GitHub Profile"
                  >
                    <i class="bx bxl-github" aria-hidden="true"></i>
                  </a>
                  <a
                    href="https://www.fiverr.com/shubhamsunny?public_mode=true"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="home__social-icon"
                    aria-label="Fiverr Profile"
                  >
                    <img src="assets/img/fiverr-logo.svg" alt="" width="18" height="18" />
                  </a>
                </div>
                <p class="home__connect-email">
                  <a href="mailto:shubhamsahaninitkkr@gmail.com">shubhamsahaninitkkr@gmail.com</a>
                </p>
              </div>
            </div>

            <div class="hero__photo">
              <figure class="home__img">
                <img
                  class="home__photo"
                  src="assets/img/home.jpg"
                  alt="Portrait of Shubham Sunny"
                  width="480"
                  height="600"
                  loading="eager"
                  decoding="async"
                />
              </figure>
              <a
                class="hero__connect-chip"
                href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=shubhamsahaninitkkr@gmail.com"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Open Gmail to email shubhamsahaninitkkr@gmail.com"
              >
                <span class="hero__connect-chip-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" focusable="false">
                    <path fill="#EA4335" d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.521-3.178 4.545-1.997L12 9.458l7.454-4.998C21.479 2.28 24 3.424 24 5.457z"/>
                  </svg>
                </span>
                <span class="hero__connect-chip-copy">
                  <span class="hero__connect-chip-lead">Connect with me</span>
                  <span class="hero__connect-chip-address" translate="no">shubhamsahaninitkkr@gmail.com</span>
                  <span class="hero__connect-chip-hint">Click to open Gmail</span>
                </span>
              </a>
            </div>
          </div>
          <p class="hero__trust" role="note">
            B.Tech, Information Technology — National Institute of Technology, Kurukshetra.
            Currently Senior Software Developer at Yum! Brands. Open to full-time, part-time,
            and freelance opportunities with teams worldwide.
          </p>
        </div>
      </section>
      </div>
      <div class="page-snap ps-layer-intro" data-section="intro">
      <section class="intro section section-band section-band--tone-a" id="intro" data-section="intro" aria-labelledby="intro-title">
        <div class="section__inner bd-container">
          <header class="section-header">
            <span class="section-subtitle">Intro</span>
            <h2 class="section-title" id="intro-title">Meet me in under 3 min</h2>
            <p class="section-lead">
              Three minutes on who I am, how I lead engineering work, and the kind of problems I take ownership of end to end.
            </p>
          </header>
          <div class="intro__layout">
          <div class="intro__media">
            <div class="intro__frame">
              <iframe
                src="https://www.youtube.com/embed/ikNDJfJGyv4?rel=0"
                title="Shubham Sunny intro video"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>
            <aside class="intro__aside">
              <p class="intro__aside-label">Interview clips</p>
              <p class="intro__aside-note">More deep-dives coming soon</p>
              <ul class="intro__clips">
              <li>
                <div class="intro__clip intro__clip--soon">
                  <span class="intro__clip-text">
                    <span class="intro__clip-label">JavaScript</span>
                    <span class="intro__clip-title">Coming soon</span>
                  </span>
                  <span class="intro__clip-soon-label">Coming soon</span>
                </div>
              </li>
              <li>
                <div class="intro__clip intro__clip--soon">
                  <span class="intro__clip-text">
                    <span class="intro__clip-label">Frontend</span>
                    <span class="intro__clip-title">Coming soon</span>
                  </span>
                  <span class="intro__clip-soon-label">Coming soon</span>
                </div>
              </li>
              <li>
                <div class="intro__clip intro__clip--soon">
                  <span class="intro__clip-text">
                    <span class="intro__clip-label">Architecture</span>
                    <span class="intro__clip-title">Coming soon</span>
                  </span>
                  <span class="intro__clip-soon-label">Coming soon</span>
                </div>
              </li>
              <li>
                <div class="intro__clip intro__clip--soon">
                  <span class="intro__clip-text">
                    <span class="intro__clip-label">AI &amp; Automation</span>
                    <span class="intro__clip-title">Coming soon</span>
                  </span>
                  <span class="intro__clip-soon-label">Coming soon</span>
                </div>
              </li>
              </ul>
            </aside>
          </div>
        </div>
      </section>
      </div>
      <div class="page-snap ps-layer-2" data-section="about">
      <section class="about section section-band section-band--tone-b" id="about" data-section="about" aria-labelledby="about-title">
        <div class="section__inner bd-container">
        <header class="section-header">
          <span class="section-subtitle">About</span>
          <h2 class="section-title" id="about-title">Engineering leader with 7+ years of impact</h2>
          <p class="section-lead">
            I build and scale web applications, automation systems, and AI-driven products
            for teams that need reliable engineering — whether you are hiring full-time,
            part-time, or for a focused freelance engagement.
          </p>
        </header>

        <div class="about__container bd-grid">
          <img
            src="assets/img/about.jpg"
            alt="Shubham Sunny"
            class="about__img"
            width="400"
            height="500"
            loading="lazy"
          />
          <div class="about__data">
            <div class="about__highlights">
              <div class="highlight">
                <span class="highlight__value">7+</span>
                <span class="highlight__label">Years experience</span>
              </div>
              <div class="highlight">
                <span class="highlight__value">Remote</span>
                <span class="highlight__label">Global availability</span>
              </div>
              <div class="highlight">
                <span class="highlight__value">NIT KKR</span>
                <span class="highlight__label">B.Tech IT · 8.6 SGPA</span>
              </div>
            </div>

            <div class="about__panels">
              <div class="about__panel">
                <h3 class="about__panel-title">What I bring</h3>
                <ul class="about__list">
                  <li>Leading development of internal tools that blend smart automation with clean, usable design.</li>
                  <li>Architecting optimized solutions for complex business challenges at scale.</li>
                  <li>Integrating machine learning into the frontend — experiences users actually feel, not just backend magic.</li>
                  <li>Building real-time dashboards and AI-powered workflows for faster, data-backed decisions.</li>
                </ul>
              </div>
              <div class="about__panel">
                <h3 class="about__panel-title">How I work with you</h3>
                <ul class="about__list">
                  <li><strong>Full-time</strong> — long-term ownership, team leadership, and product architecture.</li>
                  <li><strong>Part-time</strong> — sustained contribution on a flexible schedule.</li>
                  <li><strong>Freelance</strong> — scoped projects with clear deliverables and timelines.</li>
                  <li>Direct communication, plain-language updates, and code that holds up after launch.</li>
                </ul>
              </div>
            </div>

            <p class="about__kicker">
              Based in Patna, Bihar, India ·
              <a href="mailto:shubhamsahaninitkkr@gmail.com">shubhamsahaninitkkr@gmail.com</a> ·
              <a href="https://github.com/ShubhamSahaniNitkkr" target="_blank" rel="noopener noreferrer">GitHub</a> ·
              <a href="https://www.linkedin.com/in/shubham-sunny-09b013129/" target="_blank" rel="noopener noreferrer">LinkedIn</a> ·
              <a href="https://shubhamsunny.com" target="_blank" rel="noopener noreferrer">shubhamsunny.com</a>
            </p>
          </div>
        </div>
        </div>
      </section>
      </div>
      <div class="page-snap ps-layer-3" data-section="experience">
      <section class="qualification section section-band section-band--tone-a" id="experience" data-section="experience" aria-labelledby="exp-title">
        <div class="section__inner bd-container">
        <header class="section-header">
          <span class="section-subtitle">Background</span>
          <h2 class="section-title" id="exp-title">Work experience &amp; education</h2>
        </header>

        <div class="timeline">
          <div class="timeline__rail" aria-hidden="true"></div>

          <div class="timeline__block timeline__block--work">
            <div class="timeline__label">
              <i class="bx bx-briefcase-alt" aria-hidden="true"></i>
              Work experience
            </div>
            <ol class="timeline__list">
              <li class="timeline__item">
                <span class="timeline__dot" aria-hidden="true"></span>
                <div class="timeline__card">
                  <time class="timeline__time">Sept 2020 – Present</time>
                  <h3 class="timeline__heading">Senior Software Developer</h3>
                  <p class="timeline__detail">Yum! Brands · India (remote)</p>
                  <p class="timeline__body">
                    I lead the development of internal tools that mix smart automation with clean,
                    usable design. From building real-time dashboards to plugging AI into our workflows,
                    I help teams make faster, data-backed decisions. Worked closely with data scientists
                    to bring machine learning into the frontend — not just behind-the-scenes magic,
                    but stuff users actually feel.
                  </p>
                </div>
              </li>
              <li class="timeline__item">
                <span class="timeline__dot" aria-hidden="true"></span>
                <div class="timeline__card">
                  <time class="timeline__time">Sept 2020 – April 2021</time>
                  <h3 class="timeline__heading">Software Developer</h3>
                  <p class="timeline__detail">Kvantum Marketing Insights (Acquired by Yum! Brands)</p>
                  <p class="timeline__body">
                    Worked on fast-moving, data-heavy UIs that help marketing teams understand what's
                    working. Built powerful dashboards using Ant Design, Redux, and lots of logic under
                    the hood — all about performance, clarity, and showing massive amounts of data in a
                    way that actually makes sense.
                  </p>
                </div>
              </li>
              <li class="timeline__item">
                <span class="timeline__dot" aria-hidden="true"></span>
                <div class="timeline__card">
                  <time class="timeline__time">Sept 2019 – Sept 2020</time>
                  <h3 class="timeline__heading">Frontend Developer</h3>
                  <p class="timeline__detail">Tolexo Online Pvt. Ltd.</p>
                  <p class="timeline__body">
                    Built the frontend for a large-scale B2B platform. Focused on reusable components
                    and fast-loading pages so buyers and sellers had a smooth experience. The pace was
                    intense — but it pushed me to write cleaner, smarter code that scaled.
                  </p>
                </div>
              </li>
              <li class="timeline__item">
                <span class="timeline__dot" aria-hidden="true"></span>
                <div class="timeline__card">
                  <time class="timeline__time">Apr 2019 – Sept 2019</time>
                  <h3 class="timeline__heading">Software Associate</h3>
                  <p class="timeline__detail">Triyama Software Pvt. Ltd.</p>
                  <p class="timeline__body">
                    This is where I started putting full-stack skills into action. Worked on web tools
                    using Node.js and Angular. Handled everything from APIs to UI — small team, big
                    expectations, and lots of late nights solving tricky problems.
                  </p>
                </div>
              </li>
            </ol>
          </div>

          <div class="timeline__block timeline__block--edu">
            <div class="timeline__label">
              <i class="bx bx-book-bookmark" aria-hidden="true"></i>
              Education
            </div>
            <ol class="timeline__list">
              <li class="timeline__item">
                <span class="timeline__dot" aria-hidden="true"></span>
                <div class="timeline__card">
                  <time class="timeline__time">2014 – 2018</time>
                  <h3 class="timeline__heading">B.Tech, Information Technology</h3>
                  <p class="timeline__detail">
                    National Institute of Technology, Kurukshetra (NITKKR) · 8.6 SGPA on scale of 10
                  </p>
                </div>
              </li>
              <li class="timeline__item">
                <span class="timeline__dot" aria-hidden="true"></span>
                <div class="timeline__card">
                  <time class="timeline__time">2014</time>
                  <h3 class="timeline__heading">12th Standard</h3>
                  <p class="timeline__detail">
                    National Institute of Open Schooling · 84.00% on scale of 100
                  </p>
                </div>
              </li>
              <li class="timeline__item">
                <span class="timeline__dot" aria-hidden="true"></span>
                <div class="timeline__card">
                  <time class="timeline__time">2012</time>
