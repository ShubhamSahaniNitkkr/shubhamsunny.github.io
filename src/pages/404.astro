---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Shubham Sunny"
  description="The page you requested could not be found."
  canonical="https://shubhamsunny.com/404"
  noindex={true}
>
  <main class="l-main" id="main-content" style="min-height:70vh;display:grid;place-items:center;padding:3rem 1.25rem;text-align:center;">
    <div>
      <p class="section-subtitle">404</p>
      <h1 class="section-title" style="margin-bottom:0.75rem;">Page not found</h1>
      <p class="section-lead" style="margin-bottom:1.5rem;">That URL doesn’t exist on this site.</p>
      <a class="button button--primary" href="./">Back to home</a>
    </div>
  </main>
</BaseLayout>
