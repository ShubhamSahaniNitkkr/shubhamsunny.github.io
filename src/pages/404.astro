---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Shubham Sunny" description="The page you requested does not exist." noindex>
  <section class="section-padding pt-32">
    <div class="container-wide text-center">
      <p class="section-index justify-center">404</p>
      <h1 class="section-title mt-3">Page not found</h1>
      <p class="section-lead mx-auto mt-4">This link doesn’t exist on the portfolio anymore.</p>
      <a href="/" class="btn-accent mt-8 inline-flex">Back to home</a>
    </div>
  </section>
</BaseLayout>
